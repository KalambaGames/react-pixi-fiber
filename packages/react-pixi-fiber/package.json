{
  "name": "react-pixi-fiber",
  "version": "3.0.0-alpha.1",
  "description": "React Fiber renderer for PixiJS",
  "main": "index.js",
  "author": "Michal Ochman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KalambaGames/react-pixi-fiber.git",
    "directory": "packages/react-pixi-fiber"
  },
  "typings": "./dist/cjs/react-pixi-fiber.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/cjs/react-pixi-fiber.d.ts",
        "default": "./index.js"
      },
      "import": {
        "types": "./dist/es/react-pixi-fiber.d.mts",
        "development": "./dist/es/react-pixi-fiber.development.js",
        "default": "./dist/es/react-pixi-fiber.production.min.js"
      },
      "require": {
        "types": "./dist/cjs/react-pixi-fiber.d.ts",
        "default": "./index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "index.js",
    "dist/",
    "src/"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=17.0.0 <20.0.0"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-test-renderer": "18.3.1",
    "pixi.js": "6.5.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1"
  },
  "scripts": {
    "build": "rm -rf dist && pnpm run build:prod && pnpm run build:dev",
    "build:dev": "cross-env NODE_ENV=development tsdown",
    "build:prod": "cross-env NODE_ENV=production tsdown",
    "check-types": "tsc -p tsconfig.json && tsc -p tsconfig.fallback.json && tsc -p tsconfig.dist-es.json && tsc -p tsconfig.dist-cjs.json",
    "prepublishOnly": "pnpm run test && pnpm run build && pnpm -w check-package",
    "test": "pnpm run test:dev && pnpm run test:prod",
    "test:cov": "pnpm run test:dev --coverage --reporter=blob --outputFile=.vitest-reports/blob-dev.json && pnpm run test:prod --coverage --reporter=blob --outputFile=.vitest-reports/blob-prod.json && vitest run --merge-reports=.vitest-reports --coverage --coverage.reportsDirectory=coverage",
    "test:dev": "vitest run --mode development",
    "test:prod": "vitest run --mode production"
  }
}
