{
  "name": "@react-pixi-fiber/pixi-5",
  "version": "1.0.0-alpha.1",
  "description": "PixiJS 5 adapter for react-pixi-fiber",
  "main": "index.js",
  "author": "Michal Ochman",
  "license": "MIT",
  "homepage": "https://react-pixi-fiber.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KalambaGames/react-pixi-fiber.git",
    "directory": "packages/pixi-5"
  },
  "typings": "./dist/cjs/pixi-5.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/cjs/pixi-5.d.ts",
        "default": "./index.js"
      },
      "import": {
        "types": "./dist/es/pixi-5.d.mts",
        "development": "./dist/es/pixi-5.development.js",
        "default": "./dist/es/pixi-5.production.min.js"
      },
      "require": {
        "types": "./dist/cjs/pixi-5.d.ts",
        "default": "./index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "index.js",
    "dist/",
    "src/"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "pixi.js": "^5.0.0",
    "react-pixi-fiber": "^3.0.0-alpha.0"
  },
  "devDependencies": {
    "pixi.js": "5.3.12",
    "react-pixi-fiber": "workspace:*"
  },
  "scripts": {
    "build": "rm -rf dist && pnpm run build:prod && pnpm run build:dev",
    "build:dev": "cross-env NODE_ENV=development tsdown",
    "build:prod": "cross-env NODE_ENV=production tsdown",
    "check-types": "tsc -p tsconfig.json",
    "test": "pnpm run test:dev && pnpm run test:prod",
    "test:dev": "vitest run --mode development",
    "test:prod": "vitest run --mode production"
  }
}
