{
  "name": "@react-pixi-fiber/react-18",
  "version": "1.0.0-beta.0",
  "description": "React 18 adapter for react-pixi-fiber",
  "main": "index.js",
  "author": "Michal Ochman",
  "license": "MIT",
  "homepage": "https://react-pixi-fiber.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KalambaGames/react-pixi-fiber.git",
    "directory": "packages/react-18"
  },
  "typings": "./dist/cjs/react-18.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/cjs/react-18.d.ts",
        "default": "./index.js"
      },
      "import": {
        "types": "./dist/es/react-18.d.mts",
        "development": "./dist/es/react-18.development.js",
        "default": "./dist/es/react-18.production.min.js"
      },
      "require": {
        "types": "./dist/cjs/react-18.d.ts",
        "default": "./index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "index.js",
    "dist/",
    "src/"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": "^18.3.1",
    "react-pixi-fiber": "^3.0.0-alpha.0"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-reconciler": "0.28.9",
    "react": "18.3.1",
    "react-pixi-fiber": "workspace:*",
    "react-reconciler": "0.29.2"
  },
  "scripts": {
    "build": "rm -rf dist && pnpm run build:prod && pnpm run build:dev",
    "build:dev": "cross-env NODE_ENV=development tsdown",
    "build:prod": "cross-env NODE_ENV=production tsdown",
    "check-types": "tsc -p tsconfig.json",
    "test": "pnpm run test:dev && pnpm run test:prod",
    "test:dev": "vitest run --mode development",
    "test:prod": "vitest run --mode production"
  }
}
