{
  "name": "@react-pixi-fiber/pixi-4",
  "version": "1.0.0-alpha.0",
  "description": "PixiJS 4 adapter for react-pixi-fiber",
  "main": "index.js",
  "author": "Michal Ochman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michalochman/react-pixi-fiber.git",
    "directory": "packages/pixi-4"
  },
  "typings": "./dist/cjs/pixi-4.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/cjs/pixi-4.d.ts",
        "default": "./index.js"
      },
      "import": {
        "types": "./dist/es/pixi-4.d.mts",
        "development": "./dist/es/pixi-4.development.js",
        "default": "./dist/es/pixi-4.production.min.js"
      },
      "require": {
        "types": "./dist/cjs/pixi-4.d.ts",
        "default": "./index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "index.js",
    "dist/",
    "src/"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@types/pixi.js": "^4.8.9",
    "pixi.js": "^4.4.0",
    "react-pixi-fiber": "^3.0.0-alpha.0"
  },
  "peerDependenciesMeta": {
    "@types/pixi.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pixi.js": "4.8.9",
    "pixi.js": "4.8.9",
    "react-pixi-fiber": "workspace:*"
  },
  "scripts": {
    "build": "rm -rf dist && pnpm run build:prod && pnpm run build:dev",
    "build:dev": "cross-env NODE_ENV=development tsdown",
    "build:prod": "cross-env NODE_ENV=production tsdown",
    "check-types": "tsc -p tsconfig.json",
    "test": "pnpm run test:dev && pnpm run test:prod",
    "test:dev": "vitest run --mode development",
    "test:prod": "vitest run --mode production"
  }
}
