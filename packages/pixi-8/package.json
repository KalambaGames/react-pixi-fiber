{
  "name": "@react-pixi-fiber/pixi-8",
  "version": "1.0.0-alpha.1",
  "description": "PixiJS 8 adapter for react-pixi-fiber",
  "main": "index.js",
  "author": "Michal Ochman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michalochman/react-pixi-fiber.git",
    "directory": "packages/pixi-8"
  },
  "typings": "./dist/cjs/pixi-8.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/cjs/pixi-8.d.ts",
        "default": "./index.js"
      },
      "import": {
        "types": "./dist/es/pixi-8.d.mts",
        "development": "./dist/es/pixi-8.development.js",
        "default": "./dist/es/pixi-8.production.min.js"
      },
      "require": {
        "types": "./dist/cjs/pixi-8.d.ts",
        "default": "./index.js"
      }
    },
    "./compat/pixi6": {
      "node": {
        "types": "./dist/cjs/compat/pixi6.d.ts",
        "default": "./compat/pixi6.js"
      },
      "import": {
        "types": "./dist/es/compat/pixi6.d.mts",
        "development": "./dist/es/compat/pixi6.development.js",
        "default": "./dist/es/compat/pixi6.production.min.js"
      },
      "require": {
        "types": "./dist/cjs/compat/pixi6.d.ts",
        "default": "./compat/pixi6.js"
      }
    },
    "./compat/pixi7": {
      "node": {
        "types": "./dist/cjs/compat/pixi6.d.ts",
        "default": "./compat/pixi6.js"
      },
      "import": {
        "types": "./dist/es/compat/pixi6.d.mts",
        "development": "./dist/es/compat/pixi6.development.js",
        "default": "./dist/es/compat/pixi6.production.min.js"
      },
      "require": {
        "types": "./dist/cjs/compat/pixi6.d.ts",
        "default": "./compat/pixi6.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "compat/",
    "index.js",
    "dist/",
    "src/"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "pixi.js": "^8.9.0",
    "react-pixi-fiber": "^3.0.0-alpha.0"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/react-test-renderer": "18.3.1",
    "pixi.js": "8.21.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-pixi-fiber": "workspace:*",
    "react-test-renderer": "18.3.1"
  },
  "scripts": {
    "build": "rm -rf dist && pnpm run build:prod && pnpm run build:dev",
    "build:dev": "cross-env NODE_ENV=development tsdown",
    "build:prod": "cross-env NODE_ENV=production tsdown",
    "check-bundle": "node scripts/check-bundle.mjs",
    "check-types": "tsc -p tsconfig.json",
    "test": "pnpm run test:dev && pnpm run test:prod",
    "test:dev": "vitest run --mode development",
    "test:prod": "vitest run --mode production"
  }
}
