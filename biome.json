{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/*.svg", "!apps/playground-pixi*/src/examples/assets"] },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "markdown": { "formatter": { "enabled": false } },
  "yaml": { "formatter": { "enabled": false } },
  "javascript": {
    "formatter": {
      "arrowParentheses": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "rules": {
      "preset": "none",
      "correctness": {
        "noChildrenProp": "error",
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error",
        "useJsxKeyInIterable": "error"
      },
      "security": { "noDangerouslySetInnerHtmlWithChildren": "error" },
      "suspicious": {
        "noCommentText": "error",
        "noDuplicateJsxProps": "error",
        "noUnknownAttribute": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "preset": "none",
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":NODE:",
              ":BLANK_LINE:",
              [
                ":PACKAGE:",
                "!react-pixi-fiber",
                "!react-pixi-fiber/**",
                "!@react-pixi-fiber/**",
                "!playground-shell/**"
              ],
              ":BLANK_LINE:",
              ["react-pixi-fiber", "react-pixi-fiber/**"],
              "@react-pixi-fiber/**",
              "playground-shell/**",
              ":BLANK_LINE:",
              ":ALIAS:",
              "../**",
              "./**"
            ]
          }
        }
      }
    }
  }
}
