{
  "name": "react-pixi-fiber-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": "github:michalochman/react-pixi-fiber",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome check",
    "format": "biome check --write",
    "check-types": "pnpm -r check-types && tsc -p scripts/tsconfig.json",
    "start": "pnpm --filter examples start",
    "playground": "pnpm --filter playground-pixi8 start",
    "check-bundle": "pnpm -r --if-present check-bundle",
    "check-package": "node scripts/check-package.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && pnpm check-package && pnpm check-bundle && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.14",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24",
    "@vitest/coverage-v8": "4.1.10",
    "canvas": "^3.2.3",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "jsdom": "28.1.0",
    "publint": "^0.3.24",
    "rolldown": "1.1.5",
    "tsdown": "0.22.8",
    "typescript": "^7.0.2",
    "vitest": "4.1.10",
    "vitest-webgl-canvas-mock": "1.1.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react-reconciler@0.26>@types/react": "^17",
      "@types/react-router-dom>@types/react": "^18.3.0",
      "@types/react-router>@types/react": "^18.3.0"
    }
  }
}
