{
  "name": "react-pixi-fiber-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": "github:KalambaGames/react-pixi-fiber",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:site": "cross-env PLAYGROUND_SITE=1 pnpm build && node scripts/build-site.mjs",
    "changeset": "changeset",
    "check-bundle": "pnpm -r --if-present check-bundle",
    "check-package": "node scripts/check-package.mjs",
    "check-types": "pnpm -r check-types && tsc -p scripts/tsconfig.json",
    "format": "biome check --write",
    "lint": "biome check",
    "release": "pnpm -r build && pnpm check-package && pnpm check-bundle && changeset publish",
    "start": "pnpm --filter \"playground-pixi*\" --parallel start",
    "test": "pnpm -r test",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.14",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "4.1.10",
    "canvas": "3.2.3",
    "cross-env": "7.0.3",
    "esbuild": "0.28.2",
    "jsdom": "28.1.0",
    "publint": "0.3.24",
    "rolldown": "1.1.5",
    "tsdown": "0.22.8",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "vitest-webgl-canvas-mock": "1.1.0"
  },
  "pnpm": {
    "overrides": {
      "@pixi/layout@1>@pixi/eslint-config": "-",
      "@pixi/layout@1>@pixi/extension-scripts": "-",
      "@pixi/layout@1>@pixi/storybook-renderer": "-",
      "@pixi/layout@1>@pixi/storybook-webpack5": "-",
      "@pixi/layout@1>@pixi/ui": "-",
      "@types/react-reconciler@0.26>@types/react": "^17"
    }
  }
}
